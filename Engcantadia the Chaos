-- Utility function to easily find and set visibility
local function setCharacterVisible(characterName)
    local player = game:GetService("Players").LocalPlayer
    
    local charObject = player:WaitForChild("PlayerGui", 5) 
        :WaitForChild("Character", 5)
        :WaitForChild("Frame", 5)
        :WaitForChild("ScrollingFrame", 5)
        :WaitForChild(characterName, 5)

    if charObject then
        charObject.Visible = true
        WindUI:Notify({
            Title = characterName .. " Shown",
            Content = "Visibility enabled successfully.",
            Icon = "check-circle",
            Duration = 3
        })
    else
        WindUI:Notify({
            Title = "Error",
            Content = characterName .. " GUI object not found.",
            Icon = "alert-triangle",
            Duration = 5
        })
    end
end

